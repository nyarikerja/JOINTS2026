# Konfigurasi Lingkungan UdaraSiaga Backend
# Salin file ini menjadi .env dan isi nilai yang diperlukan

# Mode offline (1 = nol request jaringan eksternal, hanya data lokal data/events)
UDARASIAGA_OFFLINE=1

# Kunci API NASA FIRMS (Opsional untuk unduh data titik api live)
FIRMS_MAP_KEY=

# Kunci API OpenAQ v3 (Opsional untuk query kualitas udara)
OPENAQ_API_KEY=
